# CardioSentinel™ - Environment Configuration Template
# Copy to .env for customized deployments

# Host & Port Settings
HOST=0.0.0.0
PORT=5000
DEBUG=False

# Production Server (Set to True to use Waitress WSGI server)
USE_WAITRESS=False

# PhysioNet Dataset Storage Directory (Relative or Absolute Path)
DATASET_DIR=datasets/mitbih_arrhythmia_database

# Machine Learning Model Artifact Path
MODEL_PATH=backend/models/arrhythmia_model.joblib

# Application Version & Environment
ENVIRONMENT=production
TELEMETRY_SAMPLE_RATE_HZ=250

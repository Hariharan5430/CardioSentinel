# CardioSentinel™ - Environment Configuration Template
# Copy to .env for customized deployments

# Host & Port Settings
HOST=0.0.0.0
PORT=5000
DEBUG=False

# Production Server (Set to True to use Waitress WSGI server)
USE_WAITRESS=False

# PhysioNet Dataset Storage Directory (Relative or Absolute Path)
DATASET_DIR=datasets/mitbih_arrhythmia_database

# Machine Learning Model Artifact Path
MODEL_PATH=backend/models/arrhythmia_model.joblib

# Application Version & Environment
ENVIRONMENT=production
TELEMETRY_SAMPLE_RATE_HZ=250

# Concurrency & Worker Threads (Gunicorn on Render)
GUNICORN_THREADS=16

# Persistence Directory (Optional - for Render Persistent Disk mounted e.g. at /var/data)
# CARDIOSENTINEL_DATA_DIR=/var/data

# ==============================================================================
# Guardian Emergency SMS Notification System (Twilio Configuration)
# ==============================================================================
# When configured, real emergency notifications are sent to verified guardians
# only for live telemetry monitoring (never during recorded MIT-BIH playback).
# Standard carrier message rates and gateway usage fees apply.
# Leave empty to keep real delivery disabled ("SMS provider not configured").

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: Public webhook URL for Twilio delivery status callbacks
# TWILIO_STATUS_CALLBACK_URL=https://your-domain.com/api/guardian/twilio_callback

# Mock Mode (Set to True for automated testing or offline emulation)
# Never sends real SMS messages when set to True.
MOCK_SMS=False
